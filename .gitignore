.next/
.next-*/
out/

# Production and coverage output
build/
dist/
coverage/

# Logs
*.log
*.log.*
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Local environment variables
.env
.env.local
.env.*.local
!.env.example

# TypeScript caches
*.tsbuildinfo

# Local runtime files
**/.cover-cache/
*.normalizing.mp3
.normalization-complete
*.pid

