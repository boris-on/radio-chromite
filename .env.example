# One place for host-specific paths. Use a Windows path locally or a Linux path
# on the server. The directory contains album folders with MP3 files.
MUSIC_LIBRARY_PATH=/srv/radio-chromite/music

# Optional. Defaults to <MUSIC_LIBRARY_PATH>-normalized.
# NORMALIZED_LIBRARY_PATH=/srv/radio-chromite/music-normalized

# Optional for local runs when Nim is not available through PATH.
# Windows example: NIM_BIN_DIR=C:\nim\nim-2.2.10\bin
# Linux example:   NIM_BIN_DIR=/opt/nim/bin

# Optional tool directories when they are not available through PATH.
# C_COMPILER_BIN_DIR=C:\msys64\mingw64\bin
# FFMPEG_BIN_DIR=C:\ffmpeg\bin

# Public domain whose DNS A/AAAA record points to this server.
RADIO_DOMAIN=radio.example.com
